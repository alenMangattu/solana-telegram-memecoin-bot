spring.application.name=

telegram.bot.token=
telegram.bot.name=

spring.datasource.driver-class-name=org.postgresql.Driver
spring.datasource.username=
spring.datasource.password=
spring.datasource.url=

spring.jpa.show-sql=true
spring.jpa.properties.hibernate.format_sql=true
spring.jpa.hibernate.ddl-auto=update

logging.level.org.hibernate.SQL=DEBUG
logging.level.org.hibernate.type.descriptor.sql=TRACE
logging.level.org.springframework.web=DEBUG
logging.level.org.springframework.web.servlet=DEBUG
logging.level.org.postgresql.Driver=DEBUG

logging.level.org.springframework.cache=DEBUG

logging.level.org.springframework.web.filter.CommonsRequestLoggingFilter=DEBUG

encryption.keys.path=./keys
wallets.path=./wallets
encryption.key.rotation.days=2

solana.cluster=TESTNET
solana.cluster.url=https://api.testnet.solana.com
solana.home.dir=${user.home}/.config/solana

spring.devtools.restart.enabled=false

server.port=8888
# birdeye.api.key=26a751a2f05d47f1a81e74fc08da9c03

# Logging configuration
logging.level.root=INFO
logging.level.com.lunax.telegramBot=INFO
logging.pattern.console=%d{yyyy-MM-dd HH:mm:ss} - %msg%n

# spring.security.enabled=false
spring.autoconfigure.exclude=org.springframework.boot.autoconfigure.security.servlet.SecurityAutoConfiguration
rm bot/src/main/java/com/lunax/telegramBot/config/SecurityConfig.java
# Enhanced logging configuration
logging.level.org.springframework.security=TRACE
logging.level.org.springframework.web=TRACE
logging.level.org.springframework.security.web.FilterChainProxy=DEBUG
logging.level.org.springframework.security.web.access.intercept.AuthorizationFilter=DEBUG

# Detailed request logging
logging.level.org.springframework.web.servlet.DispatcherServlet=DEBUG
loggin.level.org.springframework.web.filter.CommonsRequestLoggingFilter.enableLoggingRequestDetails='false'

spring.jpa.open-in-view=false
