			<groupId>com.mmorrell</groupId>
			<artifactId>solanaj-programs</artifactId>
			<version>1.33.6</version>
			<type>pom</type>
		</dependency>


		<dependency>
			<groupId>com.mmorrell</groupId>
			<artifactId>phoenix</artifactId>
			<version>1.33.6</version>
		</dependency>

		<!-- https://mvnrepository.com/artifact/com.github.ipfs/java-ipfs-http-client -->
